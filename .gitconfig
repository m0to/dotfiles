# Identity (name/email) is kept out of this public repo. setup.sh seeds these
# local files from the .example templates; edit them with your real values:
#   ~/.gitconfig-identity   default identity (see .gitconfig-identity.example)
#   ~/.gitconfig-work        work identity for ~/workplace/radicle/ repos
# Order matters: the unconditional include sets the default; the conditional one
# overrides it inside work repos.
[include]
    path = ~/.gitconfig-identity
[includeIf "gitdir:~/workplace/radicle/"]
    path = ~/.gitconfig-work
[init]
    defaultBranch = main
[push]
    default = simple
[pull]
    ff = only
[core]
    excludesfile = ~/.gitignore
    editor = code
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    line-numbers = true
[color]
    ui = true
    branch = auto
    diff = auto
    status = auto
[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green
[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold
[color "status"]
    added = yellow
    changed = green
    untracked = cyan
[alias]
    co = checkout
    st = status
    br = branch
    ci = commit
    m = checkout main
    sign = commit --amend -sC HEAD
    amend = commit --amend -C HEAD
    l = log --graph --date=short --pretty='format:%C(green)%ad %C(yellow)%h%Creset %C(cyan)%aN%Creset %s%C(magenta bold)%d%Creset'
    ll = log --decorate=short --name-status -M
    lme = log --author=Jason --decorate=short --name-status -M
    p = format-patch main
    trash-clean = !git ls-files --others --exclude-standard -z | xargs -0 trash-put
    rebased-branch-delete = !sh -c 'git cherry main $1 | grep -v "^-" > /dev/null && $( git br -d "$1" || exit 0 )  || git br -D "$1"' -
    brd = !git delete-merged-branches
    bb = bisect bad
    bg = bisect good
    bs = bisect skip
    hash = rev-parse HEAD
    init-commit = commit --allow-empty -m 'Initial commit'

[diff "ruby"]
    wordRegex = (@@?|\\b:|[^:]:)?[[:alnum:]_]+|:\"[^\"]+\"|::|[^[:space:]]
[diff "php"]
    wordRegex = \\${0,2}[[:alnum:]_]+|::|->|[^[:space:]]
[merge]
    tool = vscode
    conflictstyle = zdiff3
[mergetool "vscode"]
    cmd = code --wait $MERGED
[mergetool]
    keepBackup = false
[diff]
    tool = vscode
[difftool "vscode"]
    cmd = code --wait --diff $LOCAL $REMOTE
[gc]
    auto = 0
[clean]
    requireForce = false
[help]
  autocorrect = 1
[rerere]
  enabled = 1
